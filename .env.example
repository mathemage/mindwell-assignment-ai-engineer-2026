# Environment Configuration
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://mindwell:mindwell_dev_password@localhost:5432/mindwell

# OpenAI API (replace with your key)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-small

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7

# Safety
ENABLE_CRISIS_DETECTION=true
ENABLE_PII_REDACTION=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS Configuration
# For development: use * to allow all origins
# For production: set comma-separated list like "https://app.example.com,https://admin.example.com"
CORS_ORIGINS=*

